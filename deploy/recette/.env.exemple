# Copier en .env (jamais versionne) et remplacer chaque valeur.
# Generer un secret : openssl rand -base64 48

# Domaine de l'environnement (enregistrement DNS A vers le serveur) ; localhost pour un essai sur un poste
JAUGEO_DOMAINE=recette.jaugeo.sn

# Version des images (etiquette) ; par defaut « recette »
JAUGEO_VERSION=recette

# Base de donnees
JAUGEO_DB_PASSWORD=a-remplacer

# Secret de signature des jetons : 32 caracteres au moins, aleatoire
JAUGEO_JWT_SECRET=a-remplacer

# Mot de passe initial du compte admin (cree si la base n'a aucun utilisateur ; a changer a la premiere connexion)
JAUGEO_ADMIN_PASSWORD=a-remplacer

# Documentation de l'API (Swagger) : true en recette si besoin, false en production
JAUGEO_API_DOCS=true

# Sauvegardes : heure (00-23, heure de Dakar), duree de conservation, dossier sur le serveur
JAUGEO_SAUVEGARDE_HEURE=02
JAUGEO_SAUVEGARDE_JOURS=30
JAUGEO_SAUVEGARDE_DOSSIER=./sauvegardes
